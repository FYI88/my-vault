3. REACT COMPONENT (`ParticlesBackground.jsx`)
-------------------------------------------------------------------------------

import { useEffect, useRef } from 'react';

const ParticlesBackground = ({ id = 'particles-js' }) => {
  const particlesRef = useRef(null);
  const particlesLoaded = useRef(false);
  const containerRef = useRef(null);

  useEffect(() => {
    const loadParticles = async () => {
      if (window.particlesJS) {
        initParticles();
        return;
      }

      if (document.querySelector(`script[src*="particles.min.js"]`)) {
        const checkParticles = setInterval(() => {
          if (window.particlesJS) {
            clearInterval(checkParticles);
            initParticles();
          }
        }, 100);
        return;
      }

      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js';
      script.async = true;
      script.onload = () => {
        initParticles();
      };
      document.head.appendChild(script);
    };

    const initParticles = () => {
      if (particlesLoaded.current || !window.particlesJS) return;

      setTimeout(() => {
        if (!particlesRef.current || particlesLoaded.current) return;
        particlesLoaded.current = true;

        window.particlesJS(id, {
          particles: {
            number: { value: 60, density: { enable: false, value_area: 472 } },
            color: { value: '#000000' },
            shape: { type: 'circle', stroke: { width: 0, color: '#000000' } },
            opacity: { value: 0.4, random: false },
            size: { value: 3, random: true },
            line_linked: {
              enable: true,
              distance: 290,
              color: '#000000',
              opacity: 0.3,
              width: 1
            },
            move: {
              enable: true,
              speed: 5,
              direction: 'none',
              random: false,
              straight: false,
              out_mode: 'out',
              bounce: false
            }
          },
          interactivity: {
            detect_on: 'canvas',
            events: {
              onhover: { enable: true, mode: 'grab' },
              onclick: { enable: true, mode: 'push' },
              resize: true
            },
            modes: {
              grab: { distance: 230, line_linked: { opacity: 0.5 } },
              push: { particles_nb: 4 }
            }
          },
          retina_detect: true
        });
      }, 100);
    };

    loadParticles();

    return () => {
      if (window.pJSDom && window.pJSDom.length > 0) {
        const pJS = window.pJSDom.find(p => p.pJS && p.pJS.fn && p.pJS.fn.vendors);
        if (pJS && pJS.pJS && pJS.pJS.fn && pJS.pJS.fn.destroys) {
          pJS.pJS.fn.destroys();
        }
      }
    };
  }, [id]);

  return (
    <div
      id={id}
      ref={(node) => {
        particlesRef.current = node;
        containerRef.current = node;
      }}
      className="absolute inset-0 w-full h-full"
      style={{
        position: 'absolute',
        top: 0,
        left: 0,
        width: '100%',
        height: '100%',
        zIndex: 0,
        pointerEvents: 'auto'
      }}
    />
  );
};

export default ParticlesBackground;
